{
  "name": "Narratium",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": ">=11.12.0 <12"
  },
  "scripts": {
    "dev": "next dev -p 5000 --turbopack",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:backend": "cd backend && go test ./...",
    "test:backend:race": "cd backend && go test -race ./...",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm test:backend"
  },
  "dependencies": {
    "@lobehub/icons-static-svg": "1.91.0",
    "@xyflow/react": "12.11.2",
    "fflate": "^0.8.3",
    "lucide-react": "1.24.0",
    "next": "16.2.10",
    "png-chunk-text": "1.0.0",
    "png-chunks-encode": "1.0.0",
    "png-chunks-extract": "1.0.0",
    "react": "19.2.7",
    "react-color": "2.19.3",
    "react-dom": "19.2.7",
    "react-hot-toast": "2.6.0",
    "sanitize-html": "2.17.6",
    "uuid": "14.0.1",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "16.2.10",
    "@tailwindcss/postcss": "4.3.2",
    "@types/node": "24.13.3",
    "@types/png-chunk-text": "1.0.3",
    "@types/png-chunks-encode": "1.0.2",
    "@types/png-chunks-extract": "1.0.2",
    "@types/react": "19.2.17",
    "@types/react-color": "3.0.13",
    "@types/react-dom": "19.2.3",
    "@types/sanitize-html": "2.16.1",
    "@typescript-eslint/eslint-plugin": "8.63.0",
    "@typescript-eslint/parser": "8.63.0",
    "eslint": "10.7.0",
    "tailwindcss": "4.3.2",
    "typescript": "6.0.3",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  }
}
